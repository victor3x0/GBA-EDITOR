[Desktop Entry]
Type=Application
Name=GBA Editor
Comment=Éditeur de jeux Game Boy Advance
# %f : le fichier <Nom>.gba-project double-cliqué est passé en argument.
# L'exe (« GBA Editor », avec un espace) doit rester quoté, sinon la spec
# découpe sur l'espace et lance « GBA » avec l'argument « Editor ».
Exec="GBA Editor" %f
Icon=icon
Categories=Development;Game;
Terminal=false
# Associe le manifeste de projet à l'éditeur (type déclaré dans
# gba-project.xml, installé dans usr/share/mime/packages/ par la CI).
MimeType=application/x-gba-project;
